# Copy to .env and fill in. .env is gitignored.

# Database (create the DB first: createdb hms, or CREATE DATABASE hms in psql)
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql+asyncpg://piira@localhost:5432/hms

# Development: set DEBUG=true when using default SECRET_KEY (app will not start otherwise)
# DEBUG=true

# Optional: JWT signing (default dev key if unset; production must set a strong value)
# SECRET_KEY=your-secret-key

# Optional: gate tenant creation (when set, POST /api/v1/tenants requires X-Create-Tenant-Secret header)
# CREATE_TENANT_SECRET=your-create-tenant-secret
# Frontend: set VITE_CREATE_TENANT_SECRET to the same value to enable the Sign up page (sends header on tenant create)
# VITE_CREATE_TENANT_SECRET=your-create-tenant-secret

# Optional: echo SQL (default false)
# DATABASE_ECHO=true
